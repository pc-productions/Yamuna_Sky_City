# Canonical production origin, no trailing slash, e.g.
# NEXT_PUBLIC_SITE_URL=https://www.yamunaskycity.com
# Used for canonical/OG URLs, sitemap and robots. While unset, the site
# serves noindex robots so a misconfigured deploy is never indexed.
NEXT_PUBLIC_SITE_URL=

# Server-only. When set, enquiry form submissions are POSTed here as JSON.
# While unset, the form reports an honest "enquiries not available yet"
# state — it never fakes a successful submission.
# See lib/actions/submitEnquiry.ts
ENQUIRY_WEBHOOK_URL=
