# Canonical production origin, no trailing slash, e.g.
# NEXT_PUBLIC_SITE_URL=https://www.yamunaskycity.com
# Used for canonical/OG URLs, sitemap and robots. While unset, the site
# serves noindex robots so a misconfigured deploy is never indexed.
NEXT_PUBLIC_SITE_URL=

# Server-only. The CRM developer's n8n webhook (URL in docs/CRM_INTEGRATION.md
# — set the value in Vercel, never commit it). Each enquiry is POSTed as
# JSON { name, email, phone, project, details } and any 2xx counts as a
# confirmed lead. While unset, the form reports an honest "enquiries not
# available yet" state — it never fakes a successful submission. Mapping
# lives in lib/integrations/crm.ts.
ENQUIRY_WEBHOOK_URL=

# Google Tag Manager container ID. Defaults to the client-supplied
# container in content/site.ts when unset; set to an empty value to
# disable tagging on a deploy (e.g. previews). Public — safe to expose.
# NEXT_PUBLIC_GTM_ID=GTM-MHNRSR6J

# Google Search Console verification token (HTML-tag method — the
# content="..." value only). Omitted from the page while unset.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Server-only. Google Sheets lead ledger — the business's own backup of
# every lead, written in parallel with the CRM (never gated by it).
# Setup and the Apps Script that receives the rows: docs/GOOGLE_SHEETS_LEADS.md
LEADS_SHEET_WEBHOOK_URL=
LEADS_SHEET_WEBHOOK_SECRET=
