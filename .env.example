# Canonical production origin, no trailing slash, e.g.
# NEXT_PUBLIC_SITE_URL=https://www.yamunaskycity.com
# Used for canonical/OG URLs, sitemap and robots. While unset, the site
# serves noindex robots so a misconfigured deploy is never indexed.
NEXT_PUBLIC_SITE_URL=

# Server-only. When set, enquiry submissions are POSTed here as JSON (the
# website lead record — see docs/CRM_INTEGRATION.md) and any 2xx counts
# as a confirmed lead. While unset, the form reports an honest "enquiries
# not available yet" state — it never fakes a successful submission.
# The CRM integration boundary is lib/integrations/crm.ts; CRM-specific
# auth variables will be added here (server-only) once the CRM agency
# supplies its API specification.
ENQUIRY_WEBHOOK_URL=

# Google Tag Manager container ID. Defaults to the client-supplied
# container in content/site.ts when unset; set to an empty value to
# disable tagging on a deploy (e.g. previews). Public — safe to expose.
# NEXT_PUBLIC_GTM_ID=GTM-MHNRSR6J
